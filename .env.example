APP_ENV=development
HOST=0.0.0.0
PORT=8000

DATABASE_URL=sqlite:///./aerosense.db

MODEL_DIR=./models
CLASSIFIER_MODEL_PATH=./models/aerosense_cnn_v1.pt
AUTOENCODER_MODEL_PATH=./models/aerosense_autoencoder_v1.pt
FEATURE_STATS_PATH=./models/feature_stats.json
REGISTRY_PATH=./models/registry.json

DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed

# Audio / feature extraction (must match training config — do not change
# without retraining, see common/config.py)
SAMPLE_RATE=16000
N_MELS=64
N_FFT=1024
HOP_LENGTH=256
WIN_LENGTH=1024
SEGMENT_DURATION=2.0
SEGMENT_HOP=1.0
FMIN=20
FMAX=8000
TOP_DB=80.0

# Overridden at runtime by models/registry.json once evaluation/evaluate.py
# has fit a real threshold from validation data. This value is only the
# fallback used if registry.json is missing.
ANOMALY_THRESHOLD=0.5
MIN_CLASSIFIER_CONFIDENCE=0.5

MAX_UPLOAD_SIZE_MB=25
MAX_AUDIO_DURATION_SECONDS=600
# Comma-separated browser origins allowed to call the API (no wildcard in production)
CORS_ORIGINS=http://localhost:5173

RANDOM_SEED=42
